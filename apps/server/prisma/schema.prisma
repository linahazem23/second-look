generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Category {
  Skincare
  Makeup
  Clothes
  Haircare
}

enum Condition {
  NeverUsed
  UsedOnce
  UsedAFewTimes
  RegularlyUsed
}

enum UserStatus {
  Good
  BuyOnlyRestricted
  Blocked
}

enum ListingStatus {
  Active
  Removed
  UnderReview
  Sold
}

enum OrderEscrowStatus {
  AwaitingPayment
  InEscrow
  PaymentFailed
  PaymentReleased
  Disputed
  Refunded
}

enum DeliveryMethod {
  Meetup
  UberCourier
  InDrive
  BostaMylerz
}

enum ReviewType {
  Product
  Person
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  passwordHash        String
  fullName            String
  // Optional pseudonym — shown instead of fullName everywhere a name is public
  // (listings, chat, reviews, community). fullName stays the real identity used
  // for KYC and admin/moderation, which always shows fullName regardless.
  username            String?       @unique
  area                String
  languagePreference  String        @default("en")
  verifiedFemale      Boolean       @default(false)
  age                 Int?
  kycStatus           String        @default("pending")
  idDocumentUrl       String?
  selfieUrl           String?
  kycRejectionReason  String?
  // Under-18 signups aren't blocked outright — a guardian (18+) consents on their
  // behalf and is the contact point for safety escalations. Verified the same way
  // as the member's own KYC: a real uploaded ID, reviewed by an admin, not an
  // automated phone check (no SMS/WhatsApp API is wired up).
  guardianName            String?
  guardianPhone           String?
  guardianEmail           String?
  guardianConsentStatus   String    @default("not_required") // not_required | pending | approved | rejected
  guardianIdDocumentUrl   String?
  guardianConsentToken    String?   @unique
  guardianRejectionReason String?
  // Forgot-password: single-use, time-boxed token emailed on request; cleared
  // the moment it's redeemed or replaced by a newer request.
  passwordResetToken      String?   @unique
  passwordResetExpiresAt  DateTime?
  // A verified phone number is Second Look's fastest channel to reach a member
  // directly for anything urgent (safety, disputes) — separate from the
  // guardian's phone, which is a different person's number entirely.
  phoneNumber             String?   @unique
  phoneVerified           Boolean   @default(false)
  phoneOtpCode            String?
  phoneOtpExpiresAt       DateTime?
  status              UserStatus    @default(Good)
  buyOnlyUntil        DateTime?
  blockedUntil        DateTime?
  flagCount           Int           @default(0)
  lastFlagAt          DateTime?
  completedSalesCount Int           @default(0)
  monetizationMode    String?
  skinType            String?
  hairType            String?
  clothingSize        String?
  // Growth/referral promo: membership perks (currently: free boosting + a Plus
  // badge) are active whenever membershipExpiresAt is in the future — checked live
  // on every read, never written back on expiry, so there's nothing to "forget".
  referralCode           String?   @unique
  referredByUserId       String?
  referredByUser         User?     @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals              User[]    @relation("Referrals")
  membershipExpiresAt    DateTime?
  videoPromoGrantsUsed   Int       @default(0)
  referralRewardsGranted Int       @default(0)
  createdAt           DateTime      @default(now())
  listings            Listing[]
  ordersAsBuyer       Order[]       @relation("BuyerOrders")
  ordersAsSeller      Order[]       @relation("SellerOrders")
  reviewsWritten      Review[]      @relation("ReviewsWritten")
  reviewsReceived     Review[]      @relation("ReviewsReceived")
  guidelineAcceptances GuidelineAcceptance[]
  wantRequests        DemandRequest[]
  boostPayments       BoostPayment[]
  savedListings       SavedListing[]
  videoSubmissions    VideoSubmission[]
  inquiriesAsBuyer    Inquiry[]     @relation("InquiriesAsBuyer")
  inquiriesAsSeller   Inquiry[]     @relation("InquiriesAsSeller")
  communityProductReviews CommunityProductReview[]
  communityThreads        CommunityThread[]
  communityReplies        CommunityReply[]
  communityThreadWatches  CommunityThreadWatcher[]
}

model VideoSubmission {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  videoUrl          String
  status            String   @default("pending") // pending | approved | rejected
  rejectionReason   String?
  reviewedByAdminId String?
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model GuidelineAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  slideIndex Int
  acceptedAt DateTime @default(now())

  @@unique([userId, slideIndex])
}

model Listing {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id])
  title           String
  category        Category
  originalPrice   Float
  price           Float
  reasonForSelling String
  condition       Condition
  allowOffers     Boolean       @default(false)
  size            String?
  // Skincare only — mirrors User.skinType so listings can be matched against
  // a buyer's own profile-quiz answer for personalization. "All" means
  // suitable for every skin type.
  skinType        String?
  // Haircare only — same idea as skinType, matched against User.hairType.
  hairType        String?
  images          String[]
  status          ListingStatus @default(Active)
  area            String
  boosted         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  reports         ListingReport[]
  savedBy         SavedListing[]
  inquiries       Inquiry[]
}

model DemandRequest {
  id            String        @id @default(cuid())
  requesterId   String
  requester     User          @relation(fields: [requesterId], references: [id])
  itemName      String
  category      Category
  area          String
  note          String?
  status        String        @default("open")
  boosted       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      DemandComment[]
  notifications DemandNotification[]
}

model DemandComment {
  id        String          @id @default(cuid())
  requestId String
  request   DemandRequest   @relation(fields: [requestId], references: [id])
  authorId  String
  body      String
  createdAt DateTime        @default(now())
}

model DemandNotification {
  id             String          @id @default(cuid())
  requestId      String
  request        DemandRequest   @relation(fields: [requestId], references: [id])
  recipientId    String
  status         String          @default("pending")
  createdAt      DateTime        @default(now())
}

model Order {
  id                String              @id @default(cuid())
  buyerId           String
  buyer             User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId          String
  seller            User                @relation("SellerOrders", fields: [sellerId], references: [id])
  listingId         String
  listing           Listing             @relation(fields: [listingId], references: [id])
  amount            Float
  buyerProtectionFee Float              @default(0)
  deliveryMethod    DeliveryMethod?
  escrowStatus      OrderEscrowStatus   @default(AwaitingPayment)
  paymobOrderId     String?
  // The actual Paymob transaction id from the webhook (distinct from paymobOrderId,
  // Paymob's *order* id) — needed to issue a refund against this specific charge.
  paymobTransactionId String?
  deliveryConfirmed Boolean            @default(false)
  deliveryConfirmedAt DateTime?
  paymentReleasedAt DateTime?
  refundedAt        DateTime?
  disputeResolutionNotes String?
  reviewUnlockAt    DateTime?
  buyerLastReadAt   DateTime?
  sellerLastReadAt  DateTime?
  createdAt         DateTime            @default(now())
  reviews           Review[]
  chats             Chat[]
  trackingLinks     TrackingLink[]
}

model TrackingLink {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  url          String
  createdAt    DateTime @default(now())
  visibleToOps Boolean  @default(true)
}

model Review {
  id                    String      @id @default(cuid())
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id])
  reviewerId            String
  reviewer              User        @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewedUserId        String
  reviewedUser          User        @relation("ReviewsReceived", fields: [reviewedUserId], references: [id])
  type                  ReviewType
  // Product review fields
  productIdentity       String?
  usageDuration         String?
  beforePhotoUrl        String?
  afterPhotoUrl         String?
  // Person review fields (structured categories, not free text)
  honestListing         Boolean?
  easyToCommunicate     Boolean?
  showedUpAsAgreed      Boolean?
  // Shared
  starRating            Int?
  notes                 String?
  createdAt             DateTime    @default(now())
  // Blind & simultaneous release for person reviews
  revealed              Boolean     @default(false)
  revealDeadline        DateTime?
  // Anti-fraud / moderation
  flagged               Boolean     @default(false)
  fraudSignals          String[]
  disputeStatus         String      @default("none")
  disputeNote           String?
}

// Open community review of a product/brand, unlinked to any specific order —
// anyone can leave one instantly, unlike the order-gated Review.type=Product
// flow above. Kept as its own model so the escrow-linked Review's required
// orderId/reviewedUserId never need to become optional for this to exist.
model CommunityProductReview {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  productIdentity String
  starRating      Int
  photoUrls       String[]
  notes           String?
  createdAt       DateTime @default(now())
}

model ListingReport {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])
  reporterId    String
  reason        String
  detailText    String?
  originalPrice Float?
  listedPrice   Float?
  status        String   @default("under_review")
  createdAt     DateTime @default(now())
}

model ModerationCase {
  id                 String   @id @default(cuid())
  contextType        String
  contextId          String
  reviewerId         String?
  reviewedUserId     String?
  // Which side is currently the target of the coaching/strike action.
  // Flips from "reviewed" to "reviewer" via the "Flag reviewer instead" action.
  flagTarget         String   @default("reviewed")
  status             String   @default("open")
  reason             String
  reviewerNotes      String?
  reviewedNotes      String?
  notes              String?
  resolvedByAdminId  String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
}

model Appeal {
  id                 String   @id @default(cuid())
  userId             String
  originalDecision   String
  originalModeratorId String?
  statement          String
  status             String   @default("pending")
  moderatorId        String?
  decisionReason     String?
  createdAt          DateTime @default(now())
  responseDueAt      DateTime?
  reviewedAt         DateTime?
}

model Ad {
  id         String   @id @default(cuid())
  slotType   String
  brand      String
  creativeUrl String?
  // Where tapping the card sends the buyer — the brand's site, a WhatsApp
  // link, whatever they gave us. Falls back to nothing (non-clickable) if unset.
  linkUrl    String?
  startDate  DateTime
  endDate    DateTime
  status     String   @default("scheduled")
  createdAt  DateTime @default(now())
}

model BoostPayment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  targetType    String
  targetId      String
  amount        Float
  paid          Boolean  @default(false)
  paymobOrderId String?
  createdAt     DateTime @default(now())
}

model Chat {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  messageText     String
  attachmentUrl   String?
  attachmentType  String?
  senderId        String
  createdAt       DateTime  @default(now())
  autoFlagged     Boolean   @default(false)
  flaggedKeyword  String?
  reported        Boolean   @default(false)
}

// Pre-purchase question thread between a buyer and a listing's seller — deliberately
// separate from Order/Chat so asking a question never starts an escrow payment hold.
model Inquiry {
  id               String            @id @default(cuid())
  listingId        String
  listing          Listing           @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User              @relation("InquiriesAsBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User              @relation("InquiriesAsSeller", fields: [sellerId], references: [id])
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime          @default(now())
  messages         InquiryMessage[]

  // Negotiation — only meaningful when the listing allows offers. offerBy names
  // whose turn it is to respond; accepting creates a real Order at offerAmount.
  offerAmount   Float?
  offerStatus   String? // pending | accepted | declined
  offerByUserId String?

  @@unique([listingId, buyerId])
}

model InquiryMessage {
  id              String    @id @default(cuid())
  inquiryId       String
  inquiry         Inquiry   @relation(fields: [inquiryId], references: [id])
  messageText     String
  attachmentUrl   String?
  attachmentType  String?
  senderId        String
  createdAt       DateTime  @default(now())
  autoFlagged     Boolean   @default(false)
  flaggedKeyword  String?
  reported        Boolean   @default(false)
}

model SupportMessage {
  id         String   @id @default(cuid())
  userId     String
  body       String
  fromSupport Boolean @default(false)
  quickReplyKey String?
  createdAt  DateTime @default(now())
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("moderator")
  fullName      String
  createdAt     DateTime @default(now())
}

// Peer-to-peer Q&A/tips board — "ask each other for consultations" on products,
// skincare tips, where to buy things, etc. Reply notifications reuse the same
// email pipeline built for chat (see lib/email.ts).
model CommunityThread {
  id        String                   @id @default(cuid())
  authorId  String
  author    User                     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  category  String?
  createdAt DateTime                 @default(now())
  replies   CommunityReply[]
  watchers  CommunityThreadWatcher[]
}

model CommunityReply {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id])
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime        @default(now())
}

// The round "notify me" toggle — a watcher gets emailed the next time someone
// replies to a thread, mirroring how Facebook-group "+1" comments work.
model CommunityThreadWatcher {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([threadId, userId])
}
