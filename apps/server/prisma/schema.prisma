generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Category {
  Skincare
  Makeup
  Clothes
  Haircare
  MomBaby
}

enum Condition {
  NeverUsed
  UsedOnce
  UsedAFewTimes
  RegularlyUsed
}

enum UserStatus {
  Good
  BuyOnlyRestricted
  Blocked
}

enum ListingStatus {
  Active
  Removed
  UnderReview
  Sold
}

enum OrderEscrowStatus {
  AwaitingDeliveryMethod
  AwaitingPayment
  InEscrow
  PaymentFailed
  PaymentReleased
  Disputed
  Refunded
  Expired
}

enum DeliveryMethod {
  Meetup
  UberCourier
  InDrive
  BostaMylerz
}

enum ReviewType {
  Product
  Person
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  passwordHash        String
  fullName            String
  // Optional pseudonym — shown instead of fullName everywhere a name is public
  // (listings, chat, reviews, community). fullName stays the real identity used
  // for KYC and admin/moderation, which always shows fullName regardless.
  username            String?       @unique
  area                String
  languagePreference  String        @default("en")
  verifiedFemale      Boolean       @default(false)
  age                 Int?
  kycStatus           String        @default("pending")
  idDocumentUrl       String?
  selfieUrl           String?
  kycRejectionReason  String?
  // Under-18 signups aren't blocked outright — a guardian (18+) consents on their
  // behalf and is the contact point for safety escalations. Verified the same way
  // as the member's own KYC: a real uploaded ID, reviewed by an admin, not an
  // automated phone check (no SMS/WhatsApp API is wired up).
  guardianName            String?
  guardianPhone           String?
  guardianEmail           String?
  guardianConsentStatus   String    @default("not_required") // not_required | pending | approved | rejected
  guardianIdDocumentUrl   String?
  guardianConsentToken    String?   @unique
  guardianRejectionReason String?
  // Forgot-password: single-use, time-boxed token emailed on request; cleared
  // the moment it's redeemed or replaced by a newer request.
  passwordResetToken      String?   @unique
  passwordResetExpiresAt  DateTime?
  // A real (unverified — no SMS provider wired up, same tradeoff as the
  // guardian's phone) contact number, so Second Look can reach a member
  // directly and fast for anything urgent (safety, disputes).
  phoneNumber             String?   @unique
  status              UserStatus    @default(Good)
  buyOnlyUntil        DateTime?
  blockedUntil        DateTime?
  flagCount           Int           @default(0)
  lastFlagAt          DateTime?
  completedSalesCount Int           @default(0)
  monetizationMode    String?
  skinType            String?
  hairType            String?
  clothingSize        String?
  // Opted in at signup — unlocks the Mom & Baby category and Community section,
  // which stay entirely hidden (server-filtered, not just UI-hidden) otherwise.
  isMother            Boolean       @default(false)
  // Profile picture — an uploaded photo takes precedence over a chosen preset
  // character when both are set; neither set falls back to initials client-side.
  avatarUrl           String?
  avatarPreset        String?
  // Spendable/accumulating reward balance, earned via lib/points.ts's awardPoints().
  points              Int           @default(0)
  // Real date stored, but only ever rendered as month+day — never age/year.
  birthday            DateTime?
  birthdayBoardHidden Boolean       @default(false)
  // EGP credit from a gift pool with no linked listing — spendable only on a
  // real Second Look order (see Order.storeCreditApplied), never withdrawable.
  storeCredit         Float         @default(0)
  // Opt-out toggle for the roaming pet animation on Home/Profile — same polarity
  // style as birthdayBoardHidden.
  petsRoamingEnabled  Boolean       @default(true)
  // Consumable daily credits — granted once per calendar day via DailyActivity
  // (opening the app grants a feed charge, reacting to a Community consultation
  // grants a water charge), spent via the pet routes.
  freeFeedCharges     Int           @default(0)
  freeWaterCharges    Int           @default(0)
  // Growth/referral promo: membership perks (currently: free boosting + a Plus
  // badge) are active whenever membershipExpiresAt is in the future — checked live
  // on every read, never written back on expiry, so there's nothing to "forget".
  referralCode           String?   @unique
  referredByUserId       String?
  referredByUser         User?     @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals              User[]    @relation("Referrals")
  membershipExpiresAt    DateTime?
  videoPromoGrantsUsed   Int       @default(0)
  referralRewardsGranted Int       @default(0)
  createdAt           DateTime      @default(now())
  listings            Listing[]
  ordersAsBuyer       Order[]       @relation("BuyerOrders")
  ordersAsSeller      Order[]       @relation("SellerOrders")
  reviewsWritten      Review[]      @relation("ReviewsWritten")
  reviewsReceived     Review[]      @relation("ReviewsReceived")
  guidelineAcceptances GuidelineAcceptance[]
  wantRequests        DemandRequest[]
  boostPayments       BoostPayment[]
  savedListings       SavedListing[]
  videoSubmissions    VideoSubmission[]
  inquiriesAsBuyer    Inquiry[]     @relation("InquiriesAsBuyer")
  inquiriesAsSeller   Inquiry[]     @relation("InquiriesAsSeller")
  communityProductReviews CommunityProductReview[]
  communityThreads        CommunityThread[]
  communityReplies        CommunityReply[]
  communityThreadWatches  CommunityThreadWatcher[]
  pointsLedger            PointsLedger[]
  charms                  UserCharm[]
  birthdayGiftPool        BirthdayGiftPool[]
  giftContributions       GiftContribution[]
  pets                    Pet[]
  petInventory            PetInventory[]
  dailyActivities         DailyActivity[]
  communityReactions      CommunityReaction[]
  reviewComments          ReviewComment[]
}

model VideoSubmission {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  videoUrl          String
  status            String   @default("pending") // pending | approved | rejected
  rejectionReason   String?
  reviewedByAdminId String?
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model GuidelineAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  slideIndex Int
  acceptedAt DateTime @default(now())

  @@unique([userId, slideIndex])
}

model Listing {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation(fields: [sellerId], references: [id])
  title           String
  category        Category
  originalPrice   Float
  price           Float
  reasonForSelling String
  condition       Condition
  allowOffers     Boolean       @default(false)
  size            String?
  // Skincare only — mirrors User.skinType so listings can be matched against
  // a buyer's own profile-quiz answer for personalization. "All" means
  // suitable for every skin type.
  skinType        String?
  // Haircare only — same idea as skinType, matched against User.hairType.
  hairType        String?
  images          String[]
  status          ListingStatus @default(Active)
  area            String
  boosted         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orders          Order[]
  reports         ListingReport[]
  savedBy         SavedListing[]
  inquiries       Inquiry[]
}

model DemandRequest {
  id            String        @id @default(cuid())
  requesterId   String
  requester     User          @relation(fields: [requesterId], references: [id])
  itemName      String
  category      Category
  area          String
  note          String?
  status        String        @default("open")
  boosted       Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  comments      DemandComment[]
  notifications DemandNotification[]
}

model DemandComment {
  id        String          @id @default(cuid())
  requestId String
  request   DemandRequest   @relation(fields: [requestId], references: [id])
  authorId  String
  body      String
  createdAt DateTime        @default(now())
}

model DemandNotification {
  id             String          @id @default(cuid())
  requestId      String
  request        DemandRequest   @relation(fields: [requestId], references: [id])
  recipientId    String
  status         String          @default("pending")
  createdAt      DateTime        @default(now())
}

model Order {
  id                String              @id @default(cuid())
  buyerId           String
  buyer             User                @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId          String
  seller            User                @relation("SellerOrders", fields: [sellerId], references: [id])
  listingId         String
  listing           Listing             @relation(fields: [listingId], references: [id])
  amount            Float
  buyerProtectionFee Float              @default(0)
  deliveryMethod    DeliveryMethod?
  escrowStatus      OrderEscrowStatus   @default(AwaitingDeliveryMethod)
  // Buy Now reserves the listing and opens chat immediately, before any payment —
  // the buyer has this long to pick a delivery method (and pay, if it's a paid
  // courier method) before the hold lazily expires and the listing reopens.
  holdExpiresAt     DateTime?
  paymobOrderId     String?
  // The actual Paymob transaction id from the webhook (distinct from paymobOrderId,
  // Paymob's *order* id) — needed to issue a refund against this specific charge.
  paymobTransactionId String?
  deliveryConfirmed Boolean            @default(false)
  deliveryConfirmedAt DateTime?
  paymentReleasedAt DateTime?
  refundedAt        DateTime?
  disputeResolutionNotes String?
  reviewUnlockAt    DateTime?
  buyerLastReadAt   DateTime?
  sellerLastReadAt  DateTime?
  // Set when this order was auto-created from a funded birthday gift pool rather
  // than a normal Buy — the money was already collected across many separate
  // contributions, so paymobOrderId/paymobTransactionId stay null here. Gives a
  // dispute/refund a trail back to the individual contributors via GiftContribution.
  giftPoolId        String?
  giftPool          BirthdayGiftPool?   @relation(fields: [giftPoolId], references: [id])
  // How much of `amount` was covered by the buyer's storeCredit rather than a
  // live Paymob charge — needed to restore credit correctly on a refund.
  storeCreditApplied Float              @default(0)
  createdAt         DateTime            @default(now())
  reviews           Review[]
  chats             Chat[]
  trackingLinks     TrackingLink[]
}

model TrackingLink {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  url          String
  createdAt    DateTime @default(now())
  visibleToOps Boolean  @default(true)
}

model Review {
  id                    String      @id @default(cuid())
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id])
  reviewerId            String
  reviewer              User        @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewedUserId        String
  reviewedUser          User        @relation("ReviewsReceived", fields: [reviewedUserId], references: [id])
  type                  ReviewType
  // Product review fields
  productIdentity       String?
  usageDuration         String?
  beforePhotoUrl        String?
  afterPhotoUrl         String?
  // Person review fields (structured categories, not free text)
  honestListing         Boolean?
  easyToCommunicate     Boolean?
  showedUpAsAgreed      Boolean?
  // Shared
  starRating            Int?
  notes                 String?
  createdAt             DateTime    @default(now())
  // Blind & simultaneous release for person reviews
  revealed              Boolean     @default(false)
  revealDeadline        DateTime?
  // Anti-fraud / moderation
  flagged               Boolean     @default(false)
  fraudSignals          String[]
  disputeStatus         String      @default("none")
  disputeNote           String?
  comments              ReviewComment[]
}

// Open community review of a product/brand, unlinked to any specific order —
// anyone can leave one instantly, unlike the order-gated Review.type=Product
// flow above. Kept as its own model so the escrow-linked Review's required
// orderId/reviewedUserId never need to become optional for this to exist.
model CommunityProductReview {
  id              String   @id @default(cuid())
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  productIdentity String
  starRating      Int
  photoUrls       String[]
  notes           String?
  // Set only for a Mom & Baby product review, posted from the mother-only
  // Reviews space — null means it belongs to the general pool everyone sees.
  category        String?
  createdAt       DateTime @default(now())
  comments        ReviewComment[]
}

model ListingReport {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id])
  reporterId    String
  reason        String
  detailText    String?
  originalPrice Float?
  listedPrice   Float?
  status        String   @default("under_review")
  createdAt     DateTime @default(now())
}

model ModerationCase {
  id                 String   @id @default(cuid())
  contextType        String
  contextId          String
  reviewerId         String?
  reviewedUserId     String?
  // Which side is currently the target of the coaching/strike action.
  // Flips from "reviewed" to "reviewer" via the "Flag reviewer instead" action.
  flagTarget         String   @default("reviewed")
  status             String   @default("open")
  reason             String
  reviewerNotes      String?
  reviewedNotes      String?
  notes              String?
  resolvedByAdminId  String?
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
}

model Appeal {
  id                 String   @id @default(cuid())
  userId             String
  originalDecision   String
  originalModeratorId String?
  statement          String
  status             String   @default("pending")
  moderatorId        String?
  decisionReason     String?
  createdAt          DateTime @default(now())
  responseDueAt      DateTime?
  reviewedAt         DateTime?
}

model Ad {
  id         String   @id @default(cuid())
  slotType   String
  // Targets one listing category (Skincare, Haircare, Makeup, Clothes,
  // MomBaby) so brands relevant to that feed show there — a hair clinic in
  // Haircare, a baby brand in Mom & Baby, etc. Null means "show for every
  // category" (also the fallback when a category has no dedicated ad).
  category   String?
  brand      String
  creativeUrl String?
  // Where tapping the card sends the buyer — the brand's site, a WhatsApp
  // link, whatever they gave us. Falls back to nothing (non-clickable) if unset.
  linkUrl    String?
  startDate  DateTime
  endDate    DateTime
  status     String   @default("scheduled")
  createdAt  DateTime @default(now())
}

model BoostPayment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  targetType    String
  targetId      String
  amount        Float
  paid          Boolean  @default(false)
  paymobOrderId String?
  createdAt     DateTime @default(now())
}

model Chat {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  messageText     String
  attachmentUrl   String?
  attachmentType  String?
  senderId        String
  createdAt       DateTime  @default(now())
  autoFlagged     Boolean   @default(false)
  flaggedKeyword  String?
  reported        Boolean   @default(false)
}

// Pre-purchase question thread between a buyer and a listing's seller — deliberately
// separate from Order/Chat so asking a question never starts an escrow payment hold.
model Inquiry {
  id               String            @id @default(cuid())
  listingId        String
  listing          Listing           @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User              @relation("InquiriesAsBuyer", fields: [buyerId], references: [id])
  sellerId         String
  seller           User              @relation("InquiriesAsSeller", fields: [sellerId], references: [id])
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  createdAt        DateTime          @default(now())
  messages         InquiryMessage[]

  // Negotiation — only meaningful when the listing allows offers. offerBy names
  // whose turn it is to respond; accepting creates a real Order at offerAmount.
  offerAmount   Float?
  offerStatus   String? // pending | accepted | declined
  offerByUserId String?

  @@unique([listingId, buyerId])
}

model InquiryMessage {
  id              String    @id @default(cuid())
  inquiryId       String
  inquiry         Inquiry   @relation(fields: [inquiryId], references: [id])
  messageText     String
  attachmentUrl   String?
  attachmentType  String?
  senderId        String
  createdAt       DateTime  @default(now())
  autoFlagged     Boolean   @default(false)
  flaggedKeyword  String?
  reported        Boolean   @default(false)
}

model SupportMessage {
  id         String   @id @default(cuid())
  userId     String
  body       String
  fromSupport Boolean @default(false)
  quickReplyKey String?
  createdAt  DateTime @default(now())
}

// General feedback about the app itself — distinct from a listing report or a
// customer-support question, both of which are about a specific thing gone
// wrong. This is just "here's what I think," read by the team, no reply loop.
model AppFeedback {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
}

// A quick, immediate pulse-check fired right when the buyer taps "Confirm
// delivery" — distinct from the considered, 6-day-locked Review. One per
// order; a resubmit just overwrites via upsert.
model DeliveryFeedback {
  id              String   @id @default(cuid())
  orderId         String   @unique
  buyerId         String
  conditionRating String   // as_described | slightly_different | not_as_described
  comment         String?
  createdAt       DateTime @default(now())
}

model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("moderator")
  fullName      String
  createdAt     DateTime @default(now())
}

// Peer-to-peer Q&A/tips board — "ask each other for consultations" on products,
// skincare tips, where to buy things, etc. Reply notifications reuse the same
// email pipeline built for chat (see lib/email.ts).
model CommunityThread {
  id        String                   @id @default(cuid())
  authorId  String
  author    User                     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  category  String?
  createdAt DateTime                 @default(now())
  replies   CommunityReply[]
  watchers  CommunityThreadWatcher[]
  reactions CommunityReaction[]
}

model CommunityReply {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id])
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime        @default(now())
}

// The round "notify me" toggle — a watcher gets emailed the next time someone
// replies to a thread, mirroring how Facebook-group "+1" comments work.
model CommunityThreadWatcher {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([threadId, userId])
}

// Catalog of earnable achievement badges — collectible, not spendable (see
// User.points for the spendable balance). Seeded once; awarded via lib/points.ts.
model Charm {
  id          String      @id @default(cuid())
  key         String      @unique
  label       String
  description String
  icon        String
  createdAt   DateTime    @default(now())
  users       UserCharm[]
}

model UserCharm {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  charmId  String
  charm    Charm    @relation(fields: [charmId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, charmId])
}

// Append-only audit trail AND the idempotency mechanism for awarding points —
// the unique constraint means a second attempt to award the same (userId,
// reason, refId) triple fails on insert (P2002) instead of racing a
// check-then-insert. A negative amount records a spend (e.g. the pet shop).
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  refId     String
  createdAt DateTime @default(now())

  @@unique([userId, reason, refId])
}

model BirthdayGiftPool {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  // If set, funding the pool auto-buys this real listing for her. If not,
  // the raised amount becomes non-cashable storeCredit instead — either way,
  // money only ever moves through a real Second Look purchase, never as a
  // direct cash handout to an individual.
  listingId       String?
  giftDescription String?
  targetAmount    Float
  raisedAmount    Float              @default(0)
  status          String             @default("open") // open | funded | expired | cancelled
  deadline        DateTime
  createdAt       DateTime           @default(now())
  contributions   GiftContribution[]
  orders          Order[]
}

model GiftContribution {
  id            String           @id @default(cuid())
  poolId        String
  pool          BirthdayGiftPool @relation(fields: [poolId], references: [id])
  contributorId String
  contributor   User             @relation(fields: [contributorId], references: [id])
  amount        Float
  paymobOrderId String?
  // Paymob's *transaction* id from the webhook (distinct from paymobOrderId) —
  // needed to issue a refund against this specific charge if the pool expires
  // underfunded, same reason Order keeps both ids.
  paymobTransactionId String?
  status        String           @default("pending") // pending | paid | failed | refunded
  createdAt     DateTime         @default(now())
}

model Pet {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  species     String
  name        String
  // An uploaded photo takes precedence over the illustrated species/stage art —
  // same precedence User.avatarUrl already has over avatarPreset.
  photoUrl    String?
  growthStage Int       @default(0)
  // Cumulative food "effect" fed over this pet's lifetime — growthStage is
  // derived from this against fixed thresholds (see lib/pets.ts), not stored
  // independently, so it can never drift out of sync.
  fedPoints   Int       @default(0)
  happiness   Int       @default(50)
  lastFedAt   DateTime?
  adoptedAt   DateTime  @default(now())
}

// Fixed shop catalog, seeded once alongside Charm — no crafting/combining.
model PetItemCatalog {
  id         String @id @default(cuid())
  key        String @unique
  name       String
  pointsCost Int
  kind       String // food | toy | accessory
  effect     Int
}

model PetInventory {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, itemKey])
}

// Once-per-calendar-day grant record AND the idempotency mechanism for daily
// feed/water charges — same idea as PointsLedger's unique constraint: a second
// grant attempt for the same (userId, kind, day) fails on insert (P2002)
// instead of racing a check-then-increment.
model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String   // feed_checkin | water_reaction
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, kind, day])
}

// A simple per-user-per-thread reaction toggle on a Community consultation —
// mirrors CommunityThreadWatcher's exact shape. The first reaction of the day
// (any thread) also grants a free water charge, handled in the route.
model CommunityReaction {
  id        String          @id @default(cuid())
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([threadId, userId])
}

// A lightweight Q&A thread attached to a review — exactly one of reviewId /
// communityProductReviewId is set (enforced at the route, not here), since
// product/person reviews and instant community reviews are two different
// parent tables.
model ReviewComment {
  id                      String                  @id @default(cuid())
  reviewId                String?
  review                  Review?                 @relation(fields: [reviewId], references: [id])
  communityProductReviewId String?
  communityProductReview  CommunityProductReview? @relation(fields: [communityProductReviewId], references: [id])
  authorId                String
  author                  User                    @relation(fields: [authorId], references: [id])
  body                    String
  createdAt               DateTime                @default(now())
}
